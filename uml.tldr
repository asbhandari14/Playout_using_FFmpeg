    {
      "id": "shape:be_server",
      "typeName": "shape",
      "type": "geo",
      "parentId": "page:page",
      "index": "a0009",
      "x": 140,
      "y": 780,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "props": {
        "w": 700,
        "h": 420,
        "geo": "rectangle",
        "color": "violet",
        "labelColor": "black",
        "fill": "semi",
        "dash": "solid",
        "size": "s",
        "font": "sans",
        "text": "[Server & Gateway Runtime]\n- server.js:\n  * HTTP & Socket.IO server creation on PORT 5000\n  * Socket rooms: io.to(\"channel:<id>\") for isolated broadcast\n  * Crash Protection: unhandledRejection & uncaughtException handlers\n  * Graceful Shutdown: PM2 / nodemon SIGUSR2 & SIGINT hooks\n  * MongoDB connection bootstrap & Playout Scheduler startup\n- app.js:\n  * Express 5 framework, Helmet security, CORS origin whitelist\n  * Static media serving: /streams/*, /uploads/*\n  * Route mounting: /api/{auth, channels, streams, playlists, ...}",
        "align": "start",
        "verticalAlign": "start",
        "growY": 0,
        "url": "",
        "scale": 1
      }
    },
    {
      "id": "shape:be_middleware",
      "typeName": "shape",
      "type": "geo",
      "parentId": "page:page",
      "index": "a0010",
      "x": 880,
      "y": 780,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "props": {
        "w": 700,
        "h": 420,
        "geo": "rectangle",
        "color": "violet",
        "labelColor": "black",
        "fill": "semi",
        "dash": "solid",
        "size": "s",
        "font": "sans",
        "text": "[Security & Validation Middleware]\n- auth.js: JWT Bearer token decoding & user hydration on req.user\n- rbac.js: Role-based authorization (super_admin, admin, user)\n- upload.js: Multer disk storage for chunked multipart video files\n- logoUpload.js: Multer image filter for PNG/JPG/GIF branding assets\n- validate.js: Zod request validation against schemas\n- errorHandler.js: Centralized operational error catching & JSON replies\nSecurity Policies:\n* Password hashing with bcrypt (salt rounds = 10)\n* AES-256-CBC server credential encryption",
        "align": "start",
        "verticalAlign": "start",
        "growY": 0,
        "url": "",
        "scale": 1
      }
    },
    {
      "id": "shape:be_controllers",
      "typeName": "shape",
      "type": "geo",
      "parentId": "page:page",
      "index": "a0011",
      "x": 1620,
      "y": 780,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "props": {
        "w": 1140,
        "h": 420,
        "geo": "rectangle",
        "color": "violet",
        "labelColor": "black",
        "fill": "semi",
        "dash": "solid",
        "size": "s",
        "font": "sans",
        "text": "[REST API Controllers & Route Handlers]\n- authController: login(), register(), refresh(), logout(), getMe()\n- channelController: getChannels(), createChannel(), updateBranding(), checkOnline()\n- streamController: startBroadcast(), stopBroadcast(), getStreamStatus(), reloadStream()\n- playlistController: getPlaylist(), addItem(), removeItem(), reorderItems(), toggleLoop()\n- brandingController: updateLogo(), updateTicker(), updateBug(), fireLBand(), fireAshton()\n- scheduleController: getSchedules(), createSchedule(), updateSchedule(), deleteSchedule()\n- assetController: initChunk(), uploadChunk(), finalizeUpload(), getAssets(), deleteAsset()\n- serverController: getServers(), createServer(), testFlussonicConnection(), syncStreams()\n- userController: getUsers(), createUser(), updateUserRole(), deleteUser()",
        "align": "start",
        "verticalAlign": "start",
        "growY": 0,
        "url": "",
        "scale": 1
      }
    },
    {
      "id": "shape:be_services_utils",
      "typeName": "shape",
      "type": "geo",
      "parentId": "page:page",
      "index": "a0012",
      "x": 2800,
      "y": 780,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "props": {
        "w": 1100,
        "h": 420,
        "geo": "rectangle",
        "color": "violet",
        "labelColor": "black",
        "fill": "semi",
        "dash": "solid",
        "size": "s",
        "font": "sans",
        "text": "[Backend Core Services & Utilities]\n- flussonicService.js:\n  * Flussonic REST API integration (http://<host>:81)\n  * sanitizeStreamKey(): alphanumeric URL-safe key sanitizer\n  * createFlussonicStream(): provisions publish:// stream with Basic Auth\n  * checkFlussonicStreamOnline(): polls stream online/bitrate telemetry\n  * deleteFlussonicStream(): cleans up stream on channel removal\n- assetService.js: Chunked file reassembly, ffprobe media validation, thumbnail creation\n- utils/crypto.js: AES-256-CBC encrypt() / decrypt() for server passwords\n- utils/token.js: generateAccessToken() (15m) & generateRefreshToken() (7d)\n- utils/media.js: ffprobe duration, resolution, codecs, and audio sample rate inspection",
        "align": "start",
        "verticalAlign": "start",
        "growY": 0,
        "url": "",
        "scale": 1
      }
    },
    {
      "id": "shape:tier3_container",
      "typeName": "shape",
